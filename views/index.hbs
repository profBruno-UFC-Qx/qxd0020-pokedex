<div class="row">
    {{#each pokemons}}
    <div class="col"> 
        <div class="card">
            <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/{{id}}.png" class="card-img-top img-fluid rounded-start" alt="{{_nome}}">
            <div class="card-body">
                <h5 class="card-title">{{_nome}}</h5>
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                <a href="/pokemons/{{id}}" class="btn btn-danger">Mais detalhes</a>
            </div>
        </div>
    </div>  
    {{/each}}    
</div>
