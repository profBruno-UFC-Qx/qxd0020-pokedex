{{#with pokemon}}
<div class="row">
    <div class="col">
        <div class="card mt-3 mb-3" style="max-width: 540px;">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/{{id}}.png" class="card-img-top img-fluid rounded-start" alt="{{_nome}}">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">{{_nome}} <small class="text-muted">
                        {{#each tipos}}
                            <span class="badge bg-secondary">{{this}}</span>
                        {{/each}}
                        </small>
                    </h5>
                    <p class="card-text">
                        Peso {{_peso}} lbs<br>
                        Altura {{_altura}} "<br>
                        Base stats
                    </p>
                    <hr>
                    <div class="row">
                        {{> stat_progress label="PvMax" valor=_pvMax valorMax=255 }}
                        {{> stat_progress label="Ataque" valor=_ataque valorMax=190}}
                        {{> stat_progress label="Defesa" valor=_defesa valorMax=230}}
                        {{> stat_progress label="Ataque Esp." valor=_ataqueEspecial valorMax=194}}
                        {{> stat_progress label="Defesa Esp" valor=_defesaEspecial valorMax=230}}
                        {{> stat_progress label="Velocidade" valor=_velocidade valorMax=180}}

                    </div>
                </div>
            </div>
        </div>
    </div> 
</div>

{{/with}}