<h2>Pokedex</h2>
<div class="row">
    {{#each pokemons}}
    <div class="col-3"> 
        <div class="card">
            <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/{{id}}.png" class="card-img-top img-fluid rounded-start" alt="{{_nome}}">
            <div class="card-body">
                <h5 class="card-title">{{_nome}}</h5>
                {{#each tipos}}
                <span class="badge bg-secondary">{{this}}</span>
                {{/each}}
                <a href="/pokemons/{{id}}" class="btn btn-danger mt-1">Mais detalhes</a>
            </div>
        </div>
    </div>  
    {{/each}}    
</div>
